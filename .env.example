# These values stay on the server. Never add secrets to public/.
# Leave Turso values unset for offline SQLite development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# On Netlify, choose a random token (at least 32 characters), create the first
# admin through /admin with it, then remove ADMIN_SETUP_TOKEN from Netlify.
ADMIN_SETUP_TOKEN=
# Connect Sender only when ready to sync subscribers and send actual emails.
EMAIL_ENABLED=false
SENDER_API_KEY=
SENDER_GUIDE_GROUP_ID=
SENDER_NEWSLETTER_GROUP_ID=
SENDER_FROM_EMAIL=
SENDER_FROM_NAME=DrealSkinhub
SITE_URL=http://127.0.0.1:4173

# These values stay on the server. Never add secrets to public/.
# Leave Turso values unset for offline SQLite development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Legacy one-time setup only if ADMIN_EMAIL/ADMIN_PASSWORD are not set.
ADMIN_SETUP_TOKEN=
# Optional environment-managed administrator. Set email and password together.
# When set, /admin uses these credentials and the one-time setup form is disabled.
# Use a unique password of at least 12 characters. Keep these server-side only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Owner
# New admin-uploaded JPG, PNG, and WebP images use Cloudinary. Payment proof
# images use Cloudinary authenticated storage. PDFs still use Netlify Blobs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Leave email disabled while sending order messages yourself. Gmail is optional
# for password resets and preview consultations, not required for checkout.
# If enabled, use an App Password (not the Gmail login password).
EMAIL_ENABLED=false
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=DrealSkinhub
# Run `node scripts/generate-vapid.mjs` locally and set this private key only
# in Netlify. The derived public key is served to authenticated admins.
PUSH_VAPID_PRIVATE_KEY=
PUSH_CONTACT_EMAIL=
SITE_URL=http://127.0.0.1:4173
# Checkout opens only when all three bank values are valid. Keep these in
# Netlify environment variables, never in public files or admin settings.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
